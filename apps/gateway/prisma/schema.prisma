// This is your Prisma schema file for AegisWAF
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Agent Registry
// ─────────────────────────────────────────────
model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  apiKey      String   @unique @map("api_key") // hashed
  active      Boolean  @default(true)
  role        String   @default("agent") // agent | admin | analyst
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  toolCalls   ToolCall[]
  policies    Policy[]
  hitlRequests HitlRequest[]

  @@map("agents")
}

// ─────────────────────────────────────────────
// Policy Definitions
// ─────────────────────────────────────────────
model Policy {
  id          String   @id @default(uuid())
  name        String
  version     Int      @default(1)
  description String?
  agentId     String?  @map("agent_id")
  yamlContent String   @map("yaml_content") // raw YAML for auditability
  parsedRules Json     @map("parsed_rules") // structured rules
  shadowMode  Boolean  @default(false)      @map("shadow_mode")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())        @map("created_at")
  updatedAt   DateTime @updatedAt            @map("updated_at")

  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([name, version])
  @@map("policies")
}

// ─────────────────────────────────────────────
// Agent Sessions
// ─────────────────────────────────────────────
model Session {
  id          String    @id // provided by caller: sess_<uuid>
  agentId     String    @map("agent_id")
  customerId  String?   @map("customer_id") // bound customer context for BOLA
  metadata    Json?
  toolSequence String[] @default([])        @map("tool_sequence") // ordered list of tools called
  createdAt   DateTime  @default(now())     @map("created_at")
  lastActiveAt DateTime @default(now())     @map("last_active_at")
  expiresAt   DateTime? @map("expires_at")

  agent       Agent     @relation(fields: [agentId], references: [id])
  toolCalls   ToolCall[]

  @@index([agentId])
  @@index([customerId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// Immutable Audit Log of All Tool Calls
// ─────────────────────────────────────────────
model ToolCall {
  id              String   @id @default(uuid()) // requestId
  agentId         String   @map("agent_id")
  sessionId       String   @map("session_id")
  tool            String
  rawParameters   Json     @map("raw_parameters")
  sanitizedParams Json     @map("sanitized_parameters")
  riskScore       Int      @map("risk_score")       // 0 - 100
  decision        Decision                          // ALLOW | BLOCK | HITL | RATE_LIMIT | SHADOW_BLOCK
  shadowMode      Boolean  @default(false)          @map("shadow_mode")
  reason          String?
  rulesEvaluated  String[] @default([])             @map("rules_evaluated")
  matchedRules    String[] @default([])             @map("matched_rules")
  latencyMs       Int      @map("latency_ms")
  executedAt      DateTime?                         @map("executed_at")
  executionStatus String?                           @map("execution_status") // SUCCESS | FAILED | NOT_EXECUTED
  executionResult Json?                             @map("execution_result")
  createdAt       DateTime @default(now())          @map("created_at")

  agent           Agent    @relation(fields: [agentId], references: [id])
  session         Session  @relation(fields: [sessionId], references: [id])
  hitlRequest     HitlRequest?
  auditEvent      AuditEvent?

  @@index([agentId, createdAt])
  @@index([sessionId])
  @@index([decision])
  @@index([tool])
  @@map("tool_calls")
}

model AuditEvent {
  id         String   @id @default(uuid())
  toolCallId String   @unique @map("tool_call_id")
  eventData  Json     @map("event_data")
  createdAt  DateTime @default(now()) @map("created_at")

  toolCall   ToolCall @relation(fields: [toolCallId], references: [id])

  @@map("audit_events")
}

enum Decision {
  ALLOW
  BLOCK
  HITL
  RATE_LIMIT
  SHADOW_BLOCK
}

// ─────────────────────────────────────────────
// Human-in-the-Loop Review Queue
// ─────────────────────────────────────────────
model HitlRequest {
  id          String     @id @default(uuid())
  toolCallId  String     @unique @map("tool_call_id")
  agentId     String     @map("agent_id")
  status      HitlStatus @default(PENDING)
  riskScore   Int        @map("risk_score")
  tool        String
  parameters  Json
  reason      String?
  reviewedBy  String?    @map("reviewed_by")
  reviewNote  String?    @map("review_note")
  reviewedAt  DateTime?  @map("reviewed_at")
  resolvedAt  DateTime?  @map("resolved_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  toolCall    ToolCall   @relation(fields: [toolCallId], references: [id])
  agent       Agent      @relation(fields: [agentId], references: [id])

  @@index([status])
  @@index([agentId])
  @@map("hitl_requests")
}

enum HitlStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ─────────────────────────────────────────────
// Security Incidents / Alerts
// ─────────────────────────────────────────────
model SecurityAlert {
  id          String      @id @default(uuid())
  severity    AlertSeverity
  title       String
  description String
  agentId     String?     @map("agent_id")
  toolCallId  String?     @map("tool_call_id")
  ruleName    String?     @map("rule_name")
  metadata    Json?
  acknowledged Boolean    @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([severity])
  @@index([createdAt])
  @@map("security_alerts")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
