NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Get from Railway PostgreSQL add-on (or local)
DATABASE_URL=postgresql://aegis:aegis_dev_password@localhost:5432/aegisdb

# Get from Railway Redis add-on (or local)
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-32-char-minimum-secret-key

# WAF Config
DEFAULT_POLICY_PATH=./policies
POLICY_RELOAD_INTERVAL_MS=30000
HITL_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=info

# CORS — set to your frontend URL
CORS_ORIGIN=http://localhost:5173
