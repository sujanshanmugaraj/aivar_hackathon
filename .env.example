# ─────────────────────────────────────────────────────────────
# AegisWAF Environment Configuration Template
# Copy this file to .env and populate your secure credentials.
# NEVER commit your actual .env file to Git!
# ─────────────────────────────────────────────────────────────

# Server Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database & Cache Credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/aegis_waf?schema=public"
REDIS_URL="redis://localhost:6379"

# Cryptographic & Auth Secrets (Generate in production with `openssl rand -hex 32`)
JWT_SECRET="replace-with-ultra-secure-random-secret-key-32-chars-minimum"
ADMIN_API_KEY="replace-with-secure-admin-api-key"

# AI Inference Provider Keys (Inject via AWS Secrets Manager in production)
OPENAI_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."
XAI_API_KEY="xai-..."

# Gateway Policy Configuration
DEFAULT_POLICY_PATH="./policies"
POLICY_RELOAD_INTERVAL_MS=30000
HITL_TIMEOUT_MINUTES=15
CORS_ORIGIN="*"
